# =============================================================================
# Variables de entorno para docker-compose.yml
#
# Copiar este archivo a ".env" (que NO se sube a git, ver .gitignore) antes de
# levantar el entorno:
#
#     cp .env.example .env
#     docker compose up -d
# =============================================================================

# UID del usuario del sistema operativo host. En Linux, ejecutar `id -u` y
# usar ese valor evita que los archivos generados dentro de ./logs y ./data
# queden con dueño "root". En Windows/Mac con Docker Desktop generalmente no
# hace falta cambiar este valor.
AIRFLOW_UID=50000

# Clave usada por Airflow para cifrar contraseñas de Connections y Variables
# guardadas en la base de datos. La que sigue es una clave de EJEMPLO, valida
# para levantar el taller localmente, pero no debe reutilizarse fuera de este
# entorno educativo. Para generar una propia:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=52HrNBs2VsgXTWEhvTqwMGnGlxaiW_0jFUTfVlbP2HA=

# Credenciales del usuario administrador que se crea automaticamente la
# primera vez que se levanta el entorno (servicio airflow-init).
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
